# ── autoStudio credentials ──────────────────────────────────────
# Copy this file to .env and fill in your own values.
# .env is gitignored — keys never leave this machine.

# Bluesky — the persona's account
# App password: bsky.app → Settings → Privacy & Security → App Passwords → Add
BLUESKY_HANDLE=yourpersona.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Telegram — zero-ban-risk channel (bots are labeled automation by design)
# token: @BotFather → /newbot · then add the bot as admin of your channel
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=@yourchannel

# fal.ai — images + video + TTS (one provider for all media)
# Key: https://fal.ai/dashboard/keys
FAL_KEY=

# Which platforms a cycle publishes to (comma-separated: bluesky,telegram)
PLATFORMS=bluesky,telegram

# Anthropic — signal scoring + captions in persona voice
# Key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
