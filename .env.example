# autoStudio credentials — copy this file to `.env` and fill in real values.
#
#   copy .env.example .env        (Windows)
#   cp .env.example .env          (macOS/Linux)
#
# `.env` is gitignored and never leaves your machine. Every line here is a
# DESCRIPTION of what to paste, never a value to paste: if a key still reads
# <like this> the studio will tell you so rather than fail at publish time.
# Check your work any time with:  python -m studio.publisher_instagram

# ── Instagram ───────────────────────────────────────────────────
# One-time setup, no App Review needed for an account you own:
#  1. In the Instagram app, make the account Professional
#     (Settings → Account type and tools → Switch to professional account)
#  2. developers.facebook.com → My Apps → Create app → use case: Instagram
#  3. In the app: Instagram → API setup with Instagram login
#       · "Add account" — log in as the persona, approve the permissions
#       · "Generate token" — copy the WHOLE value with the copy button
#         (the field shows only part of it; a hand-selection truncates it)
#  4. The same panel shows that account's numeric id — that is USER_ID.
#
# The handle proves which account these keys belong to; the studio refuses
# to publish when it disagrees with the account registry.
INSTAGRAM_HANDLE=<the account's @handle, without the @>
INSTAGRAM_USER_ID=<the numeric id shown next to the account, ~17 digits>
INSTAGRAM_ACCESS_TOKEN=<the long token, starts IGAA (or EAA), 150-300 chars>

# Only needed if your token came from the Facebook-login flow (starts EAA):
# these let the studio renew it before it lapses at 60 days.
# INSTAGRAM_APP_ID=<Meta app dashboard → App settings → Basic>
# INSTAGRAM_APP_SECRET=<same page, click Show>

# ── image generation ────────────────────────────────────────────
# fal.ai key for the image/video factory (fal.ai/dashboard/keys)
FAL_KEY=<your fal.ai key>

# ── optional: licensed stock photos ─────────────────────────────
# Without this, personas configured for stock media fall back to a local
# placeholder rather than paying for generation (pexels.com/api).
# PEXELS_API_KEY=<your Pexels key>

# ── optional: other platforms ───────────────────────────────────
# TELEGRAM_BOT_TOKEN=<from @BotFather>
# TELEGRAM_CHANNEL=<@your_channel>
# BLUESKY_HANDLE=<handle.bsky.social>
# BLUESKY_APP_PASSWORD=<app password, not the account password>

# Per-persona keys, when one platform holds several accounts: suffix the
# variable with the persona's name, e.g.
# INSTAGRAM_ACCESS_TOKEN__JUNE=<June's token>
# INSTAGRAM_ACCESS_TOKEN__MARA=<Mara's token>
