# ── autoStudio credentials ──────────────────────────────────────
# Copy this file to .env and fill in your own values.
# .env is gitignored — keys never leave this machine.

# Bluesky — the persona's account
# App password: bsky.app → Settings → Privacy & Security → App Passwords → Add
BLUESKY_HANDLE=yourpersona.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Telegram — zero-ban-risk channel (bots are labeled automation by design)
# token: @BotFather → /newbot · then add the bot as admin of your channel
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=@yourchannel

# fal.ai — images + video + TTS (one provider for all media)
# Key: https://fal.ai/dashboard/keys
FAL_KEY=

# Which platforms a cycle publishes to (comma-separated: bluesky,telegram)
PLATFORMS=bluesky,telegram

# Anthropic — signal scoring + captions in persona voice
# Key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── Persona selection ───────────────────────────────────────────
# Which persona commands speak as when not told (--persona overrides).
# Configs live in config/personas/*.yaml; accounts in config/accounts.yaml.
PERSONA=june

# ── Instagram — the revenue platform ────────────────────────────
# Professional (business/creator) account required. Publishing to an account
# you own needs NO App Review and NO Business Verification — Standard Access
# covers it. The long-lived token lasts 60 days and must be refreshed.
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_HANDLE=athomewithjunecaprio

# ── Public media host — Instagram only ──────────────────────────
# Instagram's API FETCHES media by URL instead of accepting an upload, so a
# local render must be publicly reachable before it can be published.
# local = copy into a directory some static host already serves.
# s3    = any S3-compatible bucket (Cloudflare R2, S3, Backblaze); needs boto3.
MEDIA_HOST=                    # local | s3
MEDIA_PUBLIC_BASE_URL=         # https://media.example.com/
MEDIA_LOCAL_DIR=               # local backend only
MEDIA_S3_BUCKET=               # s3 backend only
MEDIA_S3_ENDPOINT=
MEDIA_S3_KEY=
MEDIA_S3_SECRET=
